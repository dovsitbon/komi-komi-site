    },
    {
      "type": "p",
      "text": "מסיבות לבנים חדש"
    },
    {
      "type": "p",
      "text": "מסיבות לבנות חדש"
    },
    {
      "type": "p",
      "text": "מסיבת מסכות חדש"
    },
    {
      "type": "p",
      "text": "מסיבת שנות ה - 60 תפאורה מדליקה"
    },
    {
      "type": "p",
      "text": "מסיבות לבתי ספר - גני ילדים"
    },
    {
      "type": "p",
      "text": "מתנ''סים - עריות - חינוך מיוחד"
    },
    {
      "type": "p",
      "text": "קיייטנות ועוד.."
    },
    {
      "type": "p",
      "text": "ניתן לשלב אטרקציות לאירוע שלכם."
    },
    {
      "type": "p",
      "text": "DJ, קריוקי, שולחנות משחק, קוסם,"
    },
    {
      "type": "p",
      "text": "קעקועים, דוכני מזון, בר אקטיבי,"
    },
    {
      "type": "p",
      "text": "מתנפחים ואטרקציות לילדים"
    },
    {
      "type": "p",
      "text": "הגברה ותאורה מקצועית"
    },
    {
      "type": "p",
      "text": "ליצנים ולטוטנים"
    },
    {
      "type": "p",
      "text": "מופע אש, הולכי קביים, שחקנים ועוד.."
    },
